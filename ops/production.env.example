# BizNez API: production settings for Coolify (Environment Variables on the API service).
# Copy each line into Coolify, fill the value, and never commit the filled file.
# Make random values with:  openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-64
# The API refuses to start on a real database if JWT_SECRET, OPERATOR_KEY, SECRETS_KEY or FILES_STORE (b2 or r2) are missing.

# --- Database (the Coolify Postgres service) ---
EMBEDDED_DB=false
# The app connects as suite_app, so each business only sees its own rows (row-level security).
DATABASE_URL=jdbc:postgresql://<postgres-service-name>:5432/suite
DATABASE_USERNAME=suite_app
DATABASE_PASSWORD=<the password set by db/production-setup.sql>
# Migrations run as the database owner.
FLYWAY_USERNAME=<postgres owner user from Coolify>
FLYWAY_PASSWORD=<postgres owner password from Coolify>
DB_POOL_SIZE=10

# --- Secrets (required; random, never reused, never changed after launch) ---
JWT_SECRET=<64+ random characters>
OPERATOR_KEY=<24+ random characters>
# Encrypts each business's PayHero / Daraja keys. Changing it later makes saved keys unreadable.
SECRETS_KEY=<openssl rand -base64 32>

# --- Addresses ---
APP_URL=https://suite.lezitech.site
SUITE_PUBLIC_API_URL=https://suite-api.lezitech.site
SITE_URL=https://lezitech.site/suite
CORS_ORIGINS=https://suite.lezitech.site,https://lezitech.site
# Where Safaricom and PayHero send payment results: the API's public address.
MPESA_CALLBACK_BASE=https://suite-api.lezitech.site

# --- First LeziTech admin (created once if no admin exists; change the password after first sign-in) ---
ADMIN_EMAIL=<owner email>
ADMIN_PASSWORD=<long temporary password>
ADMIN_DEMO_LOGINS=false
# One-click demo businesses for sales demos. Keep true only if you demo from the live server.
DEMO_LOGINS=true
TEAM_EMAIL=<inbox that receives "set it up for me" and contact requests>
SUPPORT_WHATSAPP=254796814154
SUPPORT_CALL=254794206566

# --- Email (Brevo) ---
EMAIL_PROVIDER=brevo
EMAIL_API_KEY=<Brevo API key (v3)>
# TODO owner: set to an address on a domain verified in Brevo (businez.com is not live yet)
EMAIL_FROM=no-reply@<your verified domain>
EMAIL_FROM_NAME=BizNez

# --- Photos and ETR uploads (required live): start free on Backblaze B2, move to Cloudflare R2 later ---
# B2: bucket (private) + application key limited to that bucket. Endpoint and region are on the bucket's page.
FILES_STORE=b2
B2_ENDPOINT=https://s3.<region>.backblazeb2.com
B2_REGION=<region, e.g. eu-central-003>
B2_KEY_ID=<keyID>
B2_APP_KEY=<applicationKey>
B2_BUCKET=biznez-files
# Later, R2: copy the bucket across (rclone sync b2:biznez-files r2:biznez-files), then set FILES_STORE=r2 and these.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# --- Subscriptions paid to LeziTech (PayHero) ---
PAYHERO_USERNAME=<PayHero API username>
PAYHERO_PASSWORD=<PayHero API password>
PAYHERO_CHANNEL_ID=<LeziTech's own PayHero channel id>

# --- Safaricom Daraja (only if LeziTech collects on its own paybill; businesses enter their own keys in the app) ---
MPESA_MODE=off
MPESA_BASE_URL=https://api.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_SUBSCRIPTION_SHORTCODE=
MPESA_C2B_SECRET=<random, used in the till-payment callback address>

# --- KRA eTIMS (off until the integrator approval) ---
ETIMS_MODE=off

# --- Meta ads tracking (optional) ---
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# --- Free days fallback (the control panel's setting wins once saved) ---
TRIAL_DAYS=7
